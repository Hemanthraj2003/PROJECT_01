
# ==============================================
# API CONFIGURATION
# ==============================================

# Backend API URL (your Next.js API or external backend)
# For local development: http://localhost:3000/api
# For production: https://your-domain.com/api
NEXT_PUBLIC_API=https://ipordomain/api

# ==============================================
# FIREBASE ADMIN SDK CONFIGURATION
# ==============================================
# Get these values from Firebase Console:
# 1. Go to Project Settings > Service Accounts
# 2. Click "Generate new private key"
# 3. Copy values from the downloaded JSON file

# Firebase Project ID (e.g., friendscars-12345)
FIREBASE_PROJECT_ID=your-project-id

# Firebase Private Key ID (from service account JSON)
FIREBASE_PRIVATE_KEY_ID=abc123def456ghi789jkl012mno345pqr678stu

# Firebase Private Key (from service account JSON)
# Note: Keep the quotes and \\n for new lines will be handled automatically
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Firebase Client Email (from service account JSON)
# Format: firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Firebase Client ID (from service account JSON)
FIREBASE_CLIENT_ID=123456789012345678901

# Firebase Auth URI (optional, has default value)
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth

# Firebase Token URI (optional, has default value)
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Firebase Auth Provider Certificate URL (optional, has default value)
FIREBASE_AUTH_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# Firebase Client Certificate URL (from service account JSON)
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com

# ==============================================
